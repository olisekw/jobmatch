# JobMatch environment. Copy to `.env` (git-ignored) and edit.
# Every value below is optional — the defaults are what `python3 app.py` uses
# with no environment at all. config.py is the single reader of these.

# ── Database ─────────────────────────────────────────────────
# SQLAlchemy-style URL. Relative sqlite path = three slashes, absolute = four.
DATABASE_URL=sqlite:///data/jobmatch.db
# Under docker compose this is built from POSTGRES_PASSWORD below and does not
# need setting here:  postgresql://jobmatch:<password>@db:5432/jobmatch

# Where CVs and the sqlite file live. Mount this as a volume in Docker.
DATA_DIR=data

# ── Web process ──────────────────────────────────────────────
# Signs session cookies. Required once the app binds to anything but loopback;
# generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Werkzeug debugger + auto-500 tracebacks. Never on in a deployment — startup
# refuses the combination of debug and a non-loopback bind.
JOBMATCH_DEBUG=1

HOST=127.0.0.1
PORT=8000

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# `text` for a terminal, `json` for one object per line — which is what makes
# `docker compose logs` greppable once web and worker interleave. The compose
# file sets json for both containers, along with JOBMATCH_COMPONENT.
LOG_FORMAT=text

# The deployed commit. Reported by /healthz and attached to every Sentry event;
# the deploy workflow passes the sha, so this rarely needs setting by hand.
# RELEASE=dev

# ── Error reporting (optional) ───────────────────────────────
# Unset = off, which is the normal case locally. sentry-sdk is installed either
# way and does nothing without a DSN; personal data is never sent (no PII, and
# a user is identified by id, not email).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Errors only. Tracing samples whole requests and eats a free-tier quota fast.
SENTRY_TRACES_SAMPLE_RATE=0

# Session cookies get `Secure` on their own: whenever HOST is not loopback, and
# always under gunicorn (which binds with --bind and never reads HOST). Setting
# this explicitly overrides both — `false` is how you run gunicorn locally over
# plain http, where a Secure cookie would simply never come back.
# SESSION_COOKIE_SECURE=false

# How many days a login lasts before it has to be repeated.
SESSION_DAYS=14

# ── Accounts ─────────────────────────────────────────────────
# Open signup. Turn this off on a deployed instance you do not want strangers
# creating accounts on — the login form keeps working for everyone who has one,
# and `python3 -m jobmatch.setpassword` still creates accounts from the shell.
ALLOW_SIGNUP=true

# Shortest password accepted at signup. Length is the only rule.
MIN_PASSWORD_LENGTH=10

# Rate limiting on login, signup and scan triggering. In-memory is
# per-process and resets on restart; a deployment with more than one web worker
# wants a shared backend (redis://...).
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true

# Reverse proxies in front of the app: 1 for the Caddy in docker-compose.yml, 2
# if a CDN is ever added, 0 if nothing proxies. Only read under gunicorn. Get
# this wrong upwards and a caller can name their own IP in X-Forwarded-For and
# walk past the per-IP limits above.
TRUSTED_PROXY_HOPS=1

# ── Scanning and the worker ──────────────────────────────────
# Scans are executed by `python3 -m jobmatch.worker`, not by the web process.
# Off makes POST /api/scan/start return 503 and stops the worker scheduling.
# Turn scanning off on any instance that is not the one allowed to hit the job
# boards — the Slovak scrapers have no API contract, and politeness delays only
# help if exactly one crawler is running.
SCAN_ENABLED=true

# How often the worker scans the boards for everybody. One crawl serves every
# user, so this is the only thing deciding how hard the boards get hit; 0 turns
# the schedule off and leaves only admin-triggered scans.
SCAN_INTERVAL_HOURS=6

# How often the worker looks for a queued scan — i.e. the worst case a manual
# scan waits before it starts.
WORKER_POLL_SECONDS=10

# A running scan writes a heartbeat this often, and is declared dead after this
# long without one, so a killed worker's row stops blocking the queue. The gap
# has to be several heartbeats wide or a slow write reaps a live scan.
SCAN_HEARTBEAT_SECONDS=15
SCAN_STALE_SECONDS=90

# `python3 app.py` also runs the worker loop in a thread, so local development
# stays one command. Ignored under gunicorn, where the worker is its own
# process — every web worker starting one would mean N crawlers.
SCAN_IN_PROCESS=true

# ── The public demo ──────────────────────────────────────────
# On means the landing page offers a seeded account anyone can sign into and
# actually use — it is not read-only, because the next reset undoes whatever a
# visitor did. Off on every instance that is somebody's real job search.
DEMO_MODE=false

# Published on the landing page, so the password is not protecting anything.
# Change them on a fork: otherwise its demo is reachable with the credentials
# in this repository.
DEMO_EMAIL=demo@jobmatch.app
DEMO_PASSWORD=demo-account-please

# How often the worker puts the demo back. 0 leaves `python3 -m jobmatch.demo`
# as the only way to reset it.
DEMO_RESET_HOURS=24

# ── Email digest ─────────────────────────────────────────────
# An unset SMTP_HOST is the normal case and turns digests off entirely: the
# worker skips the pass, the CLI refuses to send, and Settings tells the user
# the instance cannot mail them — the same way SENTRY_DSN behaves.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 465 is implicit TLS (the socket is encrypted before a byte of SMTP); 587 is
# plaintext until STARTTLS upgrades it. Each defaults off the other and off the
# port, so the usual pair needs neither line — set them only to override.
# SMTP_SSL=false
# SMTP_STARTTLS=true
SMTP_TIMEOUT=30

# Who it comes from. MAIL_FROM defaults to SMTP_USER, which is the address most
# relays require the sender to be anyway; a host without one counts as
# unconfigured, because a message with no sender is rejected at delivery.
MAIL_FROM=
MAIL_FROM_NAME=JobMatch

# Absolute base for the links in an email. The digest is built by the worker,
# which has no request to derive a URL from, so this is the only way it can
# know its own address. Unset means jobs link straight to the board instead.
PUBLIC_BASE_URL=

# How often one account can be mailed. 0 turns the schedule off and leaves
# `python3 -m jobmatch.digest` as the only way to send one.
DIGEST_INTERVAL_HOURS=24

# How many jobs one email carries. The rest are not marked as sent, so they
# lead the next digest rather than being dropped.
DIGEST_MAX_JOBS=10

# ── docker compose only ──────────────────────────────────────
# Read by docker-compose.yml, not by config.py. Ignored by `python3 app.py`.

# Postgres password. `docker compose up` refuses to start without it, and
# DATABASE_URL for the containers is built from it.
POSTGRES_PASSWORD=

# The hostname Caddy gets a certificate for. Its A/AAAA record has to point at
# this box before the first `up`, or ACME fails and Let's Encrypt rate-limits
# the retries.
DOMAIN=jobmatch.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com
