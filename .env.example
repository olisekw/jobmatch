# JobMatch environment. Copy to `.env` (git-ignored) and edit.
# Every value below is optional — the defaults are what `python3 app.py` uses
# with no environment at all. config.py is the single reader of these.

# ── Database ─────────────────────────────────────────────────
# SQLAlchemy-style URL. Relative sqlite path = three slashes, absolute = four.
DATABASE_URL=sqlite:///data/jobmatch.db
# Postgres (from the containerized deploy onward):
# DATABASE_URL=postgresql://jobmatch:secret@db:5432/jobmatch

# Where CVs and the sqlite file live. Mount this as a volume in Docker.
DATA_DIR=data

# ── Web process ──────────────────────────────────────────────
# Signs session cookies. Required once the app binds to anything but loopback;
# generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Werkzeug debugger + auto-500 tracebacks. Never on in a deployment — startup
# refuses the combination of debug and a non-loopback bind.
JOBMATCH_DEBUG=1

HOST=127.0.0.1
PORT=8000

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ── Behaviour ────────────────────────────────────────────────
# Off makes POST /api/scan/start return 503. Turn scanning off on any instance
# that is not the one allowed to hit the job boards — the Slovak scrapers have
# no API contract and politeness delays only help if one crawler runs at a time.
SCAN_ENABLED=true

# Public read-only demo instance (not consumed yet).
DEMO_MODE=false
